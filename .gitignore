# 系统垃圾
.DS_Store

# 日志与临时文件
*.log
temp_*
cache/

# 环境/密钥（本项目暂无，留着防呆）
.env

# ===== 以下均为个人复盘记录，公开仓库不上传（2026-08-27 起）=====

# 每日报告产物（可由 data/ 重新生成）
outputs/*.html
outputs/*.json

# 每日复盘数据与索引（个人记录，本地保留）
data/daily/*.json
data/index.json

# 盘前速览数据与报告（个人记录，本地保留，v7 起）
data/pre/*.json
outputs/pre/
*.bak_*

# 归档区（原始抓取数据、临时脚本、旧备份）
archive/

# 工作交接卡（含每日复盘明细、自选股与买卖建议）
docs/current_task_handoff.md

# ===== 以上为个人数据隔离线 =====

# 项目内部状态（含 Agent 记忆笔记，禁止外传）
.workbuddy/

# 本地网页服务运行时文件（PID；日志已被 *.log 忽略）
.stock-review.pid

# 个人自选股清单（真实文件本地保留，仓库只提交示例；见 config/stocks.example.json）
config/stocks.json
